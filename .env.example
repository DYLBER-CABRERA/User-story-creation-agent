# --- Gemini (proveedor principal) ---
# Consigue la clave en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Verifica el nombre de modelo vigente en la documentación de Gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (respaldo local) ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Comportamiento ---
# Orden de proveedores: el primero es el principal, los demás son respaldo
PROVIDER_ORDER=gemini,ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# Umbrales del veredicto (promedio INVEST de 1 a 5)
APPROVE_THRESHOLD=4.0
MIN_THRESHOLD=3.0
