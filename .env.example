# --- Ollama (proveedor principal: rápido y sin costo, corre en tu PC) ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# num_ctx = ventana de contexto (prompt + salida). num_predict=-1 = SIN TOPE de
# generación: el modelo escribe todo lo que pida hasta cerrar su JSON (puede tardar
# minutos). Pon un número positivo si quieres limitar la salida por seguridad.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=-1

# --- Gemini (respaldo opcional, solo si Ollama no responde) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PROVIDER_ORDER=ollama,gemini
LLM_TEMPERATURE=0.4
