# --- Ollama (proveedor principal: rápido y sin costo, corre en tu PC) ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Contexto y salida acotados a propósito: menos tokens = respuesta más rápida
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1800

# --- Gemini (respaldo opcional, solo si Ollama no responde) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PROVIDER_ORDER=ollama,gemini
LLM_TEMPERATURE=0.4
